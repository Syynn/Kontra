    if e.state~="rendered" or not e.lastBox then return nil,"no current on-screen body: "..str(e.state,90) end
    if not finite(e.distance) then return nil,"body distance unavailable" end
    if cfg.AimMaxDistance>0 and e.distance>cfg.AimMaxDistance then return nil,"beyond aim distance limit" end
