end
local function xyz(value)
    if not value then return nil end
    local ok,x,y,z=pcall(function() return value.X,value.Y,value.Z end)
    if ok and finite(x) and finite(y) and finite(z) then return {x,y,z} end
end
local function xy(value)
    if not value then return nil end
    local ok,x,y=pcall(function() return value.X,value.Y end)
    if ok and finite(x) and finite(y) then return x,y end
end
local function id(obj)
