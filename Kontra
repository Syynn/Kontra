                if drawn then
                    local chamOk,chamError=pcall(FX.chams,slot,e,now,vw,vh,visible)
                    if not chamOk then
                        FX.chamErrors=FX.chamErrors+1; FX.chamFault=str(chamError); cfg.Chams=false
                        event("Chams disabled: "..str(chamError))
                        for _,obj in ipairs(slot.chams or {}) do pcall(assign,obj,"Visible",false) end
                    end
                end
                if drawn and not slot.extrasFailed then
                    local extraOk,extraError=pcall(renderExtras,slot,e,now)
                    if not extraOk then
                        stats.drawErrors=stats.drawErrors+1; event("Extras disabled for this slot: "..str(extraError))
                        slot.extrasFailed=true
