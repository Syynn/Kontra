local function metadata()
    local rows={"-- FOCUSED OWNERSHIP METADATA (read only; no inferred ownership) --"}
    local bytes,omitted=0,0
    local function add(line)
        if bytes+#line>60000 then omitted=omitted+1; return false end
        rows[#rows+1]=line; bytes=bytes+#line+1; return true
    end
    local function valueText(value)
        local v=xyz(value)
        if v then return string.format("Vector3(%.3f,%.3f,%.3f)",v[1],v[2],v[3]) end
        if type(value)=="table" or type(value)=="userdata" then
            local ok,name=pcall(function() return value:GetFullName() end)
            if ok and type(name)=="string" then return str(name,220) end
        end
        return type(value)..":"..str(value,220)
    end
    local function attrs(obj)
        local ok,raw=pcall(function() return obj:GetAttributes() end)
        if not ok or type(raw)~="table" then return "unavailable" end
        local fields={}
        for key,value in pairs(raw) do
            local name
            if type(key)=="string" then name=key
            elseif type(value)=="string" then name=value; local good,result=pcall(function() return obj:GetAttribute(name) end); value=good and result or nil end
            if name and #fields<16 then fields[#fields+1]=str(name,60).."="..valueText(value) end
        end
        table.sort(fields)
        return #fields>0 and table.concat(fields,"; ") or "none"
    end
    local good,players=pcall(function() return game:GetService("Players"):GetPlayers() end)
    if good and type(players)=="table" then
        for i,player in ipairs(players) do
            if i>32 then break end
            local fields={}
            for _,key in ipairs({"Team","RelayTag","RoundSpawn","SpawnProtected","Spectating","IsSpectating","Alive","Dead"}) do
                local ok,value=pcall(function() return player:GetAttribute(key) end)
                fields[#fields+1]=key.."="..(ok and valueText(value) or "read error")
            end
            add("PLAYER "..str(get(player,"Name")).." "..table.concat(fields,"; "))
        end
    end
    for _,e in ipairs(entries) do
        add("MODEL ID "..e.name.." Attributes="..attrs(e.model))
        local queue,head={{obj=e.model,path=e.name,depth=0}},1
        while head<=#queue and head<=96 do
            local item=queue[head]; head=head+1
            local class=get(item.obj,"ClassName")
            local attributes=attrs(item.obj)
            add("NODE "..item.path.." ["..str(class).."] attributes="..attributes)
            if class=="StringValue" or class=="ObjectValue" or class=="IntValue" or class=="NumberValue" or class=="BoolValue" then
                add("  VALUE="..valueText(get(item.obj,"Value")))
            elseif class=="TextLabel" then add("  TEXT="..str(get(item.obj,"Text"),240)) end
            if item.depth<4 then
                for i,obj in ipairs(children(item.obj) or {}) do
                    if i>64 or #queue>=160 then break end
                    queue[#queue+1]={obj=obj,path=item.path.."/"..str(get(obj,"Name"),90),depth=item.depth+1}
                end
            end
        end
        if head<=#queue then add("  Metadata node cap reached") end
    end
    if omitted>0 then rows[#rows+1]="Metadata byte budget reached; omitted lines="..omitted end
    return rows
end
