            for _,name in ipairs({"Spectating","IsSpectating","Dead","Alive"}) do
                local good,value=pcall(function() return player:GetAttribute(name) end)
                if good and ((name=="Alive" and value==false) or (name~="Alive" and value==true)) then
                    C.LocalAimBlock="local "..name.."="..tostring(value); break
                end
            end
        end
    end
    local nextTeam=ok and readLocalTeam(player) or nil
    if nextTeam~=C.LocalTeam then
        C.LocalTeam=nextTeam; ui.dirty=true; hideAll()
        event("Local team now "..tostring(nextTeam).." (Player Team attribute)")
    end
    local nextEntries,nextMap={},{}; stats.excluded=0
    if root then
        local models=children(root); assert(models,"Characters children unreadable")
        for _,model in ipairs(models) do
            local name=get(model,"Name")
            if type(name)=="string" then
                if not same(get(model,"Parent"),root) or ignored(name) or same(model,localCharacter) then stats.excluded=stats.excluded+1
                else
                    local class=get(model,"ClassName")
                    if class=="Model" or class=="Folder" then
                        local key=id(model)
                        local e=entryMap[key]
                        if not e then e={model=model,name=str(name,80),key=key,parts={},nextParts=0,nextTeam=0,firstSeen=now} end
                        e.model=model; e.name=str(name,80)
                        local needParts=now>=e.nextParts
                        local needTeam=now>=e.nextTeam
                        if needParts or needTeam then
                            local list=children(model)
                            if list then
                                if needParts then
                                    e.parts=collect(model,list); e.renderParts=selectRenderParts(e.parts)
                                    e.nextParts=now+(#e.parts==15 and cfg.PartsInterval or cfg.PartialPartsInterval)
                                    stats.partRefreshes=stats.partRefreshes+1
                                end
                                if needTeam then
                                    e.team,e.teamEvidence=inferTeam(model,list)
                                    e.nextTeam=now+(e.team and cfg.TeamInterval or cfg.CacheInterval)
                                    stats.teamRefreshes=stats.teamRefreshes+1
                                end
