local function inferTeam(model,modelChildren)
    -- Read only the actual Accessories folder. Weapon names and arbitrary suffixes are not evidence.
    local folder
    for _,obj in ipairs(modelChildren or children(model) or {}) do
        if get(obj,"Name")=="Accessories" and get(obj,"ClassName")=="Folder" then folder=obj; break end
    end
    if not folder then return nil,"Accessories missing" end
    local counts,seen,evidence={T=0,CT=0},{},{}
    for _,obj in ipairs(children(folder) or {}) do
        local name=get(obj,"Name")
        if type(name)=="string" and get(obj,"ClassName")=="Accessory" then
            local key=string.lower(name); local team=uniforms[key]
            if team and not seen[key] then
                seen[key]=true; counts[team]=counts[team]+1; evidence[#evidence+1]=name
            end
        end
    end
    table.sort(evidence)
    local detail=table.concat(evidence,",")
    if counts.T>0 and counts.CT>0 then return nil,"CONFLICT: "..detail end
    if counts.T>=2 then return "T",detail end
    if counts.CT>=2 then return "CT",detail end
    return nil,"insufficient: "..detail
end
local function readLocalTeam(player)
    local ok,value=pcall(function() return player:GetAttribute("Team") end)
    if ok and type(value)=="string" then
        value=string.upper(value:match("^%s*(.-)%s*$"))
        if value=="CT" or value=="T" then return value end
    end
    return nil
end
local bodyNames={head=true,uppertorso=true,lowertorso=true,leftupperarm=true,rightupperarm=true,
    leftlowerarm=true,rightlowerarm=true,lefthand=true,righthand=true,leftupperleg=true,
    rightupperleg=true,leftlowerleg=true,rightlowerleg=true,leftfoot=true,rightfoot=true}
local function collect(model,modelChildren)
    local parts,seen={},{}
    local queue,head={{obj=model,depth=0}},1
    local examined=0
    while head<=#queue and examined<cfg.MaxNodesPerBody do
        local item=queue[head]; head=head+1; examined=examined+1
        local list=(item.obj==model and modelChildren) or children(item.obj)
        if list then
            for i=1,math.min(#list,cfg.MaxChildrenPerNode) do
                local obj=list[i]
                local name=get(obj,"Name"); name=type(name)=="string" and string.lower(name) or ""
                if bodyNames[name] and not seen[name] then
                    local class=get(obj,"ClassName")
                    if class=="Part" or class=="MeshPart" or class=="UnionOperation" then
                        local size=xyz(get(obj,"Size"))
                        if size and math.min(size[1],size[2],size[3])>.01 and math.max(size[1],size[2],size[3])<=cfg.MaxPartSize then
                            parts[#parts+1]={obj=obj,name=name,size=size}; seen[name]=true
                        end
                    end
                elseif item.depth<cfg.BodyDepth and #queue<cfg.MaxNodesPerBody then
                    -- Descend only through folders/models; equipment parts are never anchors.
                    local class=get(obj,"ClassName")
                    if class=="Model" or class=="Folder" then queue[#queue+1]={obj=obj,depth=item.depth+1} end
                end
            end
        end
        if #parts==15 then break end
    end
    table.sort(parts,function(a,b)
        local rank={uppertorso=1,head=2,lowertorso=3}
        local ar,br=rank[a.name] or 10,rank[b.name] or 10
        if ar==br then return a.name<b.name end
        return ar<br
    end)
    return parts
end
local fastNames={head=true,uppertorso=true,lowertorso=true,leftfoot=true,rightfoot=true}
local function selectRenderParts(parts)
    local result={}
    for _,part in ipairs(parts) do if fastNames[part.name] then result[#result+1]=part end end
    if #result==0 and parts[1] then result[1]=parts[1] end
    return result
end
local function refresh()
