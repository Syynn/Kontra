    if not a or math.max(math.abs(m[1]-a[1]),math.abs(m[2]-a[2]),math.abs(m[3]-a[3]))>cfg.MaxBodySpan then return nil end
    local points={}; local size=part.size
    for _,sx in ipairs({-.5,.5}) do for _,sy in ipairs({-.5,.5}) do for _,sz in ipairs({-.5,.5}) do
        local x,y,z=size[1]*sx,size[2]*sy,size[3]*sz
        local px,py=project(m[1]+m[4]*x+m[5]*y+m[6]*z,m[2]+m[7]*x+m[8]*y+m[9]*z,m[3]+m[10]*x+m[11]*y+m[12]*z)
        -- Skip a clipped part rather than invent off-screen WorldToScreen values.
        if not px or px<0 or py<0 or px>vw or py>vh then return nil end
        points[#points+1]={px,py}
    end end end
    return FX.hull(points)
end
function FX.chams(slot,e,now,vw,vh,rank)
    slot.chams=slot.chams or {}
    if not cfg.Chams or FX.chamFault or rank>cfg.ChamsMaxTargets then
        for _,obj in ipairs(slot.chams) do assign(obj,"Visible",false) end
        slot.nextChams=0; return
    end
    -- Never reuse a previous model's polygon after slot assignment changes.
    if slot.chamModel~=e.model then slot.nextChams=0; slot.chamModel=e.model end
    if slot.nextChams and now<slot.nextChams then
        for i,obj in ipairs(slot.chams) do assign(obj,"Visible",i<=(slot.chamCount or 0)) end
        return
    end
    slot.nextChams=now+1/cfg.ChamsHz; FX.chamUpdates=FX.chamUpdates+1
    local count=0
    for _,part in ipairs(e.parts) do
        local hull=FX.partHull(e,part,vw,vh)
        if hull and #hull>=3 then
            for i=2,#hull-1 do
                count=count+1; local obj=slot.chams[count]
                if not obj then
                    obj=tryDrawing("Triangle",purple)
                    if not obj then error("Drawing Triangle unavailable") end
                    slot.chams[count]=obj; slot.objects[#slot.objects+1]=obj
                    assign(obj,"Filled",true); pcall(assign,obj,"ZIndex",0)
                end
                vector2(obj,"PointA",hull[1][1],hull[1][2]); vector2(obj,"PointB",hull[i][1],hull[i][2]); vector2(obj,"PointC",hull[i+1][1],hull[i+1][2])
                assign(obj,"Transparency",cfg.ChamsOpacity); assign(obj,"Visible",true)
            end
        end
    end
    slot.chamCount=count; FX.chamTriangles=FX.chamTriangles+count
    for i=count+1,#slot.chams do assign(slot.chams[i],"Visible",false) end
end
