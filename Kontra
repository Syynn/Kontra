    else
        local list=children(currentWorld); assert(list,"Workspace children unreadable")
        for _,obj in ipairs(list) do if get(obj,"Name")=="Characters" then nextRoot=obj; break end end
    end
    world=currentWorld
    if not same(root,nextRoot) then
        hideAll(); entryMap={}; event(nextRoot and "Bound Workspace.Characters" or "Waiting for Workspace.Characters")
    end
    root=nextRoot
    local ok,player=pcall(function() return game:GetService("Players").LocalPlayer end)
    localCharacter=ok and get(player,"Character") or nil
    if now>=nextLocalState then
        nextLocalState=now+cfg.LocalStateInterval; C.LocalAimBlock=nil
