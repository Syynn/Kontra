local function updateBones(e,now)
    if not cfg.Skeleton then e.boneScreen=nil; e.nextBones=0; return end
    if e.nextBones and now<e.nextBones and e.boneScreen then return end
    e.nextBones=now+1/cfg.SkeletonHz; e.boneScreen={}; stats.skeletonUpdates=stats.skeletonUpdates+1
    local anchor=e.framePositions[e.anchorName]
    if not anchor then return end
    for _,part in ipairs(e.parts) do
        local pos=e.framePositions[part.name]
        if not pos then stats.skeletonReads=stats.skeletonReads+1; pos=readBodyPosition(e,part) end
        if pos and math.max(math.abs(pos[1]-anchor[1]),math.abs(pos[2]-anchor[2]),math.abs(pos[3]-anchor[3]))<=cfg.MaxBodySpan then
            stats.skeletonProjections=stats.skeletonProjections+1
            local x,y=project(pos[1],pos[2],pos[3])
            if x then e.boneScreen[part.name]={x,y} end
        end
    end
end
