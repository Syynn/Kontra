        lastRefresh=now; local before=clock(); stats.refreshes=stats.refreshes+1
        local ok,err=pcall(refresh)
        local cost=clock()-before; stats.cacheTotal=stats.cacheTotal+cost; stats.cacheMax=math.max(stats.cacheMax,cost)
        if not ok then stats.cacheFailures=stats.cacheFailures+1; entries={}; stats.cached=0; C.State="waiting: "..str(err); hideAll() end
    end
    if not world then hideAll(); aimIdle("workspace unavailable"); return end
    camera=get(world,"CurrentCamera")
    local vw,vh=xy(get(camera,"ViewportSize")); local camPos=xyz(get(camera,"Position"))
    if not vw or vw<=0 or vh<=0 or not camPos then C.State="waiting for camera"; hideAll(); aimIdle("camera unavailable"); return end
