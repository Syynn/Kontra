local function step(now)
    controls(now); if not C.Running then return end
    if now-lastRefresh>=cfg.CacheInterval then
        lastRefresh=now; local before=clock(); stats.refreshes=stats.refreshes+1
        local ok,err=pcall(refresh)
        local cost=clock()-before; stats.cacheTotal=stats.cacheTotal+cost; stats.cacheMax=math.max(stats.cacheMax,cost)
        if not ok then stats.cacheFailures=stats.cacheFailures+1; entries={}; stats.cached=0; C.State="waiting: "..str(err); hideAll() end
    end
    if not world then hideAll(); aimIdle("workspace unavailable"); return end
    camera=get(world,"CurrentCamera")
    local vw,vh=xy(get(camera,"ViewportSize")); local camPos=xyz(get(camera,"Position"))
    if not vw or vw<=0 or vh<=0 or not camPos then C.State="waiting for camera"; hideAll(); aimIdle("camera unavailable"); return end
    local soundOk,soundError=pcall(FX.sound,now,camPos)
    if not soundOk then
        FX.errors=FX.errors+1; FX.soundFault=str(soundError)
        for _,slot in pairs(FX.pool) do for _,key in ipairs({"ring","label"}) do if slot[key] then pcall(assign,slot[key],"Visible",false) end end end
    end
    if not C.Enabled or not root then hideAll(); aimIdle("client disabled / body folder unavailable"); return end
    C.Viewport={vw,vh}; C.State="tracking"; local visible=0
    for i,e in ipairs(entries) do
        local ok,b=pcall(geometry,e,camPos,vw,vh)
        if ok and b then
            if cfg.ESPEnabled then
            local slot=slots[i]
            if not slot then slot=newSlot(); slots[i]=slot end
            if not slot.failed then
                local drawn,err=pcall(renderSlot,slot,e,b,vw,vh)
                if drawn then visible=visible+1
                else slot.failed=true; stats.drawErrors=stats.drawErrors+1; event("Slot failed: "..str(err)); hideSlot(slot) end
                if drawn then
                    local chamOk,chamError=pcall(FX.chams,slot,e,now,vw,vh,visible)
                    if not chamOk then
                        FX.chamErrors=FX.chamErrors+1; FX.chamFault=str(chamError); cfg.Chams=false
                        event("Chams disabled: "..str(chamError))
                        for _,obj in ipairs(slot.chams or {}) do pcall(assign,obj,"Visible",false) end
                    end
                end
                if drawn and not slot.extrasFailed then
                    local extraOk,extraError=pcall(renderExtras,slot,e,now)
                    if not extraOk then
                        stats.drawErrors=stats.drawErrors+1; event("Extras disabled for this slot: "..str(extraError))
                        slot.extrasFailed=true
                        for _,line in pairs(slot.bones or {}) do pcall(assign,line,"Visible",false) end
                        if slot.dot then pcall(assign,slot.dot,"Visible",false) end
                    end
                end
            end
            else
                if slots[i] then hideSlot(slots[i]) end
            end
        else
            e.nextBones=0; e.boneScreen=nil
            if slots[i] then slots[i].nextChams=0 end
            if slots[i] then hideSlot(slots[i]) end
            if not ok then e.state="geometry read error"; stats.stale=stats.stale+1 end
        end
    end
    for i,slot in pairs(slots) do if i>#entries then hideSlot(slot) end end
    stats.visible=visible; stats.maxVisible=math.max(stats.maxVisible,visible); stats.renders=stats.renders+1
    aimStep(now,vw,vh)
end
