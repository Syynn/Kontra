end
local function project(x,y,z)
    stats.projections=stats.projections+1
    local ok,screen,onScreen=pcall(function() return WorldToScreen(Vector3.new(x,y,z)) end)
    if not ok then stats.projectionErrors=stats.projectionErrors+1; return nil end
    if onScreen~=true then return nil end
    local sx,sy=xy(screen)
    if sx then return sx,sy end
    stats.projectionErrors=stats.projectionErrors+1
end
local function readBodyPosition(e,part)
    stats.bodyReads=stats.bodyReads+1
    local read,parent,value=pcall(function() return part.obj.Parent,part.obj.Position end)
    if read and same(parent,e.model) then
        local pos=xyz(value)
        if pos then return pos end
        stats.badPositions=stats.badPositions+1
    else stats.stale=stats.stale+1; e.nextParts=0 end
end
local function geometry(e,camPos,vw,vh)
    e.lastBox=nil; e.distance=nil; e.anchorName=nil; e.framePositions={}; e.headScreen=nil
    if not same(get(e.model,"Parent"),root) then e.state="model left Characters"; stats.stale=stats.stale+1; return nil end
    if cfg.EnemiesOnly then
        if not C.LocalTeam then e.state="hidden: local team unavailable or spectator"; stats.localTeamSkips=stats.localTeamSkips+1; return nil end
        if not e.team then e.state="hidden: unknown/conflicting uniform"; stats.unknownSkips=stats.unknownSkips+1; return nil end
        if e.team==C.LocalTeam then e.state="hidden: teammate uniform"; stats.teammateSkips=stats.teammateSkips+1; return nil end
    end
    local positions={}; local anchor
    for _,part in ipairs(cfg.DetailedBounds and e.parts or e.renderParts or e.parts) do
        local pos=readBodyPosition(e,part)
        if pos then
            positions[#positions+1]={pos=pos,part=part}; e.framePositions[part.name]=pos
            if not anchor then
                anchor=positions[#positions]; e.anchorName=part.name; e.lastAnchor=pos
                e.distance=math.sqrt((pos[1]-camPos[1])^2+(pos[2]-camPos[2])^2+(pos[3]-camPos[3])^2)
                stats.maxObservedDistance=math.max(stats.maxObservedDistance,e.distance)
                if cfg.UnavailableDistance>0 and e.distance>cfg.UnavailableDistance then
                    e.state="position unavailable: extreme-distance candidate"; stats.extremePositions=stats.extremePositions+1; return nil
                end
                if cfg.MaxDistance>0 and e.distance>cfg.MaxDistance then e.state="range"; stats.range=stats.range+1; return nil end
            end
        end
    end
    if not anchor then e.state="no valid body parts"; return nil end
    local p=anchor.pos
    local b={math.huge,math.huge,math.huge,-math.huge,-math.huge,-math.huge}
    local accepted=0
    for _,g in ipairs(positions) do
        local pos,size=g.pos,g.part.size
        if math.max(math.abs(pos[1]-p[1]),math.abs(pos[2]-p[2]),math.abs(pos[3]-p[3]))<=cfg.MaxBodySpan then
            for axis=1,3 do b[axis]=math.min(b[axis],pos[axis]-size[axis]/2); b[axis+3]=math.max(b[axis+3],pos[axis]+size[axis]/2) end
            accepted=accepted+1
        end
    end
    if accepted==0 then e.state="no compact geometry"; return nil end
    local left,top,right,bottom=math.huge,math.huge,-math.huge,-math.huge
    local count=0
    if cfg.DetailedBounds then
        for _,x in ipairs({b[1],b[4]}) do for _,y in ipairs({b[2],b[5]}) do for _,z in ipairs({b[3],b[6]}) do
            local sx,sy=project(x,y,z)
            if sx and sx>=0 and sy>=0 and sx<=vw and sy<=vh then
                count=count+1; left=math.min(left,sx); right=math.max(right,sx); top=math.min(top,sy); bottom=math.max(bottom,sy)
            end
        end end end
    else
        local cx,cz=(b[1]+b[4])/2,(b[3]+b[6])/2
        local tx,ty=project(cx,b[5],cz)
        local bx,by=project(cx,b[2],cz)
        if tx and bx then
            local height=math.abs(by-ty)
            local center=(tx+bx)/2
            local width=height*.48+math.abs(tx-bx)
            left,right=center-width/2,center+width/2
            top,bottom=math.min(ty,by),math.max(ty,by); count=2
        else
            -- A real on-screen anchor can still mark a partially clipped body.
            local ax,ay=project(p[1],p[2],p[3])
            if ax then
                left,right=ax,ax; top,bottom=ay,ay; count=1
                if tx then left=math.min(left,tx); right=math.max(right,tx); top=math.min(top,ty); bottom=math.max(bottom,ty) end
                if bx then left=math.min(left,bx); right=math.max(right,bx); top=math.min(top,by); bottom=math.max(bottom,by) end
                stats.partialMarkers=stats.partialMarkers+1
            end
        end
    end
    if count==0 then e.state="off-screen / no valid body projection"; stats.offscreen=stats.offscreen+1; return nil end
    local width,height=right-left,bottom-top
    if width<cfg.MinimumBoxWidth or height<cfg.MinimumBoxHeight then stats.minimumMarkers=stats.minimumMarkers+1 end
    local cx,cy=(left+right)/2,(top+bottom)/2
    width,height=math.max(width,cfg.MinimumBoxWidth),math.max(height,cfg.MinimumBoxHeight)
    left,right=cx-width/2,cx+width/2; top,bottom=cy-height/2,cy+height/2
    left,top=clamp(left-cfg.Padding,0,vw),clamp(top-cfg.Padding,0,vh)
    right,bottom=clamp(right+cfg.Padding,0,vw),clamp(bottom+cfg.Padding,0,vh)
    if right-left<1 or bottom-top<1 then e.state="tiny projection"; return nil end
    e.state="rendered"; e.lastBox={left,top,right,bottom}; e.bodyBounds=b
    stats.farthestRendered=math.max(stats.farthestRendered,e.distance)
    if not e.firstVisible then e.firstVisible=clock(); e.discoveryToVisible=e.firstVisible-e.firstSeen end
    return e.lastBox
end
