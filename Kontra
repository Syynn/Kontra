function FX.sound(now,camPos)
    if not FX.soundFault then
        local ok,err=pcall(FX.scan,now,camPos)
        if not ok then FX.errors=FX.errors+1; FX.soundFault=str(err); event("Sound markers disabled: "..str(err)) end
    end
    for i=#FX.marks,1,-1 do
        if now-FX.marks[i].at>=cfg.SoundLifetime then table.remove(FX.marks,i); FX.expired=FX.expired+1 end
    end
    local shown=0
    for _,mark in ipairs(FX.marks) do
        local pos=mark.pos
        local distance=math.sqrt((pos[1]-camPos[1])^2+(pos[2]-camPos[2])^2+(pos[3]-camPos[3])^2)
        local ally=cfg.SoundHideAllies and mark.team and C.LocalTeam and mark.team==C.LocalTeam
        local selected=(mark.kind=="STEP" or mark.kind=="LAND") and cfg.SoundSteps or (mark.kind=="SHOT" and cfg.SoundShots) or (mark.kind~="STEP" and mark.kind~="LAND" and mark.kind~="SHOT" and cfg.SoundOther)
        local x,y
        if C.Enabled and cfg.SoundESP and selected and not ally and distance<=cfg.SoundRange then x,y=project(pos[1],pos[2],pos[3]) end
        if x and not FX.soundFault then
            shown=shown+1; local slot=FX.pool[shown]
            if not slot then slot={}; FX.pool[shown]=slot end
            local color=mark.team and (mark.team==C.LocalTeam and gray or purple) or pale
            if not slot.ring and not slot.ringUnavailable and features.circle then
                slot.ring=tryDrawing("Circle",color)
                if slot.ring then assign(slot.ring,"Filled",false); assign(slot.ring,"NumSides",48) end
                slot.ringUnavailable=not slot.ring
            end
            if not slot.label and not slot.labelUnavailable and features.text then
                slot.label=tryDrawing("Text",color); slot.labelUnavailable=not slot.label
            end
            local age=clamp((now-mark.at)/cfg.SoundLifetime,0,1)
            if slot.ring then
                assign(slot.ring,"Color",color); vector2(slot.ring,"Position",x,y)
                assign(slot.ring,"Radius",4+age*11); assign(slot.ring,"Visible",true)
                pcall(assign,slot.ring,"Transparency",1-age*.85)
            end
            if slot.label then
                assign(slot.label,"Color",color)
                assign(slot.label,"Text",mark.kind..(mark.team and (" ~"..mark.team) or " ?")..string.format(" | %.0f studs | %.1fs",distance,now-mark.at))
                vector2(slot.label,"Position",x+9,y-12); assign(slot.label,"Visible",true)
                pcall(assign,slot.label,"Transparency",1-age*.85)
            end
        end
    end
    FX.visible=shown
    for i,slot in pairs(FX.pool) do if i>shown then for _,key in ipairs({"ring","label"}) do if slot[key] then pcall(assign,slot[key],"Visible",false) end end end end
end
-- Independent convex hull over each current oriented body part. No mesh,
-- Highlight instance, material change or wall-visibility inference is involved.
function FX.hull(points)
    table.sort(points,function(a,b) return a[1]==b[1] and a[2]<b[2] or a[1]<b[1] end)
    local function turn(a,b,c) return (b[1]-a[1])*(c[2]-a[2])-(b[2]-a[2])*(c[1]-a[1]) end
    local h={}
    for _,p in ipairs(points) do
        while #h>=2 and turn(h[#h-1],h[#h],p)<=0 do table.remove(h) end
        h[#h+1]=p
    end
    local lower=#h
    for i=#points-1,1,-1 do
        local p=points[i]
        while #h>lower and turn(h[#h-1],h[#h],p)<=0 do table.remove(h) end
        h[#h+1]=p
    end
    if #h>1 then table.remove(h) end
    return h
end
function FX.partHull(e,part,vw,vh)
    if not same(get(part.obj,"Parent"),e.model) then return nil end
    local ok,m=pcall(function() return {part.obj.CFrame:GetComponents()} end)
    if not ok or #m~=12 then FX.chamSkipped=FX.chamSkipped+1; return nil end
    for i=1,12 do if not finite(m[i]) then FX.chamSkipped=FX.chamSkipped+1; return nil end end
    local a=e.lastAnchor
    if not a or math.max(math.abs(m[1]-a[1]),math.abs(m[2]-a[2]),math.abs(m[3]-a[3]))>cfg.MaxBodySpan then return nil end
    local points={}; local size=part.size
    for _,sx in ipairs({-.5,.5}) do for _,sy in ipairs({-.5,.5}) do for _,sz in ipairs({-.5,.5}) do
        local x,y,z=size[1]*sx,size[2]*sy,size[3]*sz
        local px,py=project(m[1]+m[4]*x+m[5]*y+m[6]*z,m[2]+m[7]*x+m[8]*y+m[9]*z,m[3]+m[10]*x+m[11]*y+m[12]*z)
        -- Skip a clipped part rather than invent off-screen WorldToScreen values.
        if not px or px<0 or py<0 or px>vw or py>vh then return nil end
        points[#points+1]={px,py}
    end end end
    return FX.hull(points)
end
function FX.chams(slot,e,now,vw,vh,rank)
    slot.chams=slot.chams or {}
    if not cfg.Chams or FX.chamFault or rank>cfg.ChamsMaxTargets then
        for _,obj in ipairs(slot.chams) do assign(obj,"Visible",false) end
        slot.nextChams=0; return
    end
    -- Never reuse a previous model's polygon after slot assignment changes.
    if slot.chamModel~=e.model then slot.nextChams=0; slot.chamModel=e.model end
    if slot.nextChams and now<slot.nextChams then
        for i,obj in ipairs(slot.chams) do assign(obj,"Visible",i<=(slot.chamCount or 0)) end
        return
    end
    slot.nextChams=now+1/cfg.ChamsHz; FX.chamUpdates=FX.chamUpdates+1
    local count=0
    for _,part in ipairs(e.parts) do
        local hull=FX.partHull(e,part,vw,vh)
        if hull and #hull>=3 then
            for i=2,#hull-1 do
                count=count+1; local obj=slot.chams[count]
                if not obj then
                    obj=tryDrawing("Triangle",purple)
                    if not obj then error("Drawing Triangle unavailable") end
                    slot.chams[count]=obj; slot.objects[#slot.objects+1]=obj
                    assign(obj,"Filled",true); pcall(assign,obj,"ZIndex",0)
                end
                vector2(obj,"PointA",hull[1][1],hull[1][2]); vector2(obj,"PointB",hull[i][1],hull[i][2]); vector2(obj,"PointC",hull[i+1][1],hull[i+1][2])
                assign(obj,"Transparency",cfg.ChamsOpacity); assign(obj,"Visible",true)
            end
        end
    end
    slot.chamCount=count; FX.chamTriangles=FX.chamTriangles+count
    for i=count+1,#slot.chams do assign(slot.chams[i],"Visible",false) end
end
