            local item=e.fields[field]
            rows[#rows+1]="  "..field.."="..(item and (item.status..":"..str(item.value,130)) or "not sampled")
        end
    end
    for _,item in ipairs(S.events) do rows[#rows+1]="SOUND EVENT "..item end
    if S.fault then rows[#rows+1]="Sound probe fault="..str(S.fault) end
    return rows
