        if class=="Sound" or class=="AudioPlayer" or class=="AudioEmitter" or class=="AudioListener" or class=="Wire" then rows[#rows+1]="AUDIO CLASS "..class.."="..count end
    end
    for _,e in ipairs(S.sounds) do
        rows[#rows+1]="SOUND "..e.path.." hint="..e.hint.." playKey="..str(e.playKey).." positionSource="..str(e.positionKind).." observedStarts="..e.starts
